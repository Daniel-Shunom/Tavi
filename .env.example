# Public browser configuration. Never use service_role or secret keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Email delivery secrets belong in Supabase Edge Function Secrets, never VITE_.
# RESEND_API_KEY
# TAVI_EMAIL_FROM (must be a verified sender)
# TAVI_PUBLIC_URL (live HTTPS site serving /media/email/)
# TAVI_POSTAL_ADDRESS
# See docs/MAILING-LIST.md for setup, previews, and reviewed release sending.

# Maintainer configuration only; streamers never need these or a client JSON.
# The desktop packager embeds this public Google Desktop OAuth app identity.
# Set in the build process environment or GitHub Actions secrets; never VITE_.
# Use Desktop app credentials, never a confidential Web OAuth client or account token.
# TAVI_YOUTUBE_CLIENT_ID=your-desktop-client.apps.googleusercontent.com
# TAVI_YOUTUBE_CLIENT_SECRET=your-desktop-client-secret
# See docs/YOUTUBE.md. The service does not automatically load this .env file.
