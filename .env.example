# Public browser configuration. Never use service_role or secret keys here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Email delivery secrets belong in Supabase Edge Function Secrets, never VITE_.
# RESEND_API_KEY
# TAVI_EMAIL_FROM (must be a verified sender)
# TAVI_PUBLIC_URL (live HTTPS site serving /media/email/)
# TAVI_POSTAL_ADDRESS
# See docs/MAILING-LIST.md for setup, previews, and reviewed release sending.
