{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavi Studio",
  "version": "../package.json",
  "identifier": "app.tavi.studio",
  "build": {
    "beforeDevCommand": "node scripts/dev.mjs",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "node scripts/prepare-service.mjs",
    "frontendDist": "../resources/service/dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:4318 ws://127.0.0.1:4318; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCM0FDN0NCN0ZDODU1NEIKUldSTFZjaC95OGM2VzczL1drUUZuUllPUmFQTVJHcytNMEpucjZQWWk5MDRSVGg2WjZFcnRnaU8K",
      "endpoints": ["https://github.com/Daniel-Shunom/Tavi/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Tavi",
    "copyright": "Tavi contributors. Character artwork by alisketch (CC BY 4.0).",
    "category": "Entertainment",
    "shortDescription": "Tavi Studio - streamer companion and OBS overlay",
    "longDescription": "Tavi Studio runs a local companion service and serves an OBS browser-source overlay at http://127.0.0.1:4318/overlay.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../resources/": "resources/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
