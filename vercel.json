{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "tsc --noEmit && vite build && node tools/prerender-landing.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/studio",
      "destination": "https://github.com/Daniel-Shunom/Tavi/blob/main/docs/RUNNING.md",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.riv",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=x-user-defined" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
